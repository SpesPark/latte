    "Globally toggle Latte awake/asleep with %@. Click the recorder below to assign a different chord.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Globally toggle Latte awake/asleep with %@. Click the recorder below to assign a different chord."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(으)로 Latte의 awake/asleep을 전역 토글합니다. 다른 단축키를 지정하려면 아래 레코더를 클릭하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@でLatteのawake/asleepをグローバルに切り替えます。別のコードを割り当てるには下のレコーダーをクリックします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@ 全局切换 Latte 的 awake/asleep。点按下方录制器以指定其他组合键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@ 全域切換 Latte 的 awake/asleep。點按下方錄製器以指定其他組合鍵。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna globalmente Latte entre activo/dormido con %@. Haz clic en el registrador de abajo para asignar otra combinación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Latte global mit %@ zwischen wach/schlafend um. Klicke unten auf den Rekorder, um eine andere Tastenkombination zuzuweisen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basculer globalement Latte entre actif/dormant avec %@. Cliquez sur l'enregistreur ci-dessous pour attribuer une autre combinaison."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne globalmente o Latte entre acordado/dormindo com %@. Clique no gravador abaixo para atribuir outra combinação."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna globalmente Latte tra attivo/sospeso con %@. Fai clic sul registratore qui sotto per assegnare un'altra combinazione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глобально переключайте Latte между awake/asleep по %@. Нажмите на регистратор ниже, чтобы назначить другое сочетание."
          }
        }
      }
    },
