    "Empty list under inverse mode is treated as a no-op (the trigger never fires).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty list under inverse mode is treated as a no-op (the trigger never fires)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "역모드에서 빈 목록은 동작 없음으로 처리됩니다(트리거가 절대 발동하지 않습니다)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反転モードで空のリストは何もしないものとして扱われます(トリガーは発動しません)。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反向模式下空列表视为不执行任何操作(触发器永远不会触发)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "反向模式下空清單視為不執行任何操作(觸發器永遠不會觸發)。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lista vacía en modo inverso se trata como inactiva (el activador no se dispara)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine leere Liste im Umkehrmodus wird als untätig behandelt (der Auslöser wird nie aktiv)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une liste vide en mode inversé est considérée comme inactive (le déclencheur ne se déclenche jamais)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista vazia no modo inverso é tratada como inativa (o gatilho nunca dispara)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un elenco vuoto in modalità inversa viene trattato come inattivo (il trigger non si attiva mai)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пустой список в инверсном режиме интерпретируется как бездействие (триггер никогда не срабатывает)."
          }
        }
      }
    },
    "Empty selection = watch every granted calendar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty selection = watch every granted calendar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 선택 = 권한이 부여된 모든 캘린더 감시."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択なし = アクセス権のあるすべてのカレンダーを監視。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择为空 = 监视所有已授权的日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇為空 = 監看所有已授權的行事曆。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selección vacía = vigilar todos los calendarios concedidos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leere Auswahl = jeden gewährten Kalender überwachen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélection vide = surveiller tous les calendriers autorisés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleção vazia = monitorar todos os calendários concedidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Selezione vuota = monitora ogni calendario concesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пустой выбор = отслеживать все разрешённые календари."
          }
        }
      }
    },
    "Empty selection means Latte watches every calendar you've granted access to.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty selection means Latte watches every calendar you've granted access to."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택을 비우면 Latte는 액세스 권한을 부여한 모든 캘린더를 감시합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択を空にすると、Latteはアクセス権を付与したすべてのカレンダーを監視します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择为空表示 Latte 监视你已授权访问的所有日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇為空表示 Latte 監看您已授權存取的所有行事曆。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selección vacía significa que Latte vigila todos los calendarios a los que has dado acceso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leere Auswahl bedeutet, dass Latte jeden Kalender überwacht, auf den du Zugriff gewährt hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sélection vide signifie que Latte surveille tous les calendriers auxquels vous avez accordé l'accès."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleção vazia significa que o Latte monitora todos os calendários aos quais você concedeu acesso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Selezione vuota significa che Latte monitora tutti i calendari a cui hai concesso l'accesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пустой выбор означает, что Latte отслеживает все календари, к которым вы предоставили доступ."
          }
