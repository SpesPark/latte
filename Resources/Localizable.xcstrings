          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur in Netzwerken, denen du vertraust (oder nie in Netzwerken, die du meidest)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
