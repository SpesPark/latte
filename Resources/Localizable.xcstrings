          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限被拒绝。请在 系统设置 → 隐私与安全性 中授予访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
