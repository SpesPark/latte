    "Permission denied. Grant access in System Settings → Privacy & Security.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한이 거부되었습니다. 시스템 설정 → 개인정보 보호 및 보안에서 접근을 허용하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限が拒否されました。システム設定 → プライバシーとセキュリティでアクセスを許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限被拒绝。请在 系统设置 → 隐私与安全性 中授予访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "權限被拒絕。請在 系統設定 → 私隱與安全性 中授予存取權。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiso denegado. Concede acceso en Ajustes del Sistema → Privacidad y seguridad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff verweigert. Zugriff in Systemeinstellungen → Datenschutz & Sicherheit gewähren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation refusée. Accordez l'accès dans Réglages Système → Confidentialité et sécurité."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissão negada. Conceda acesso em Ajustes do Sistema → Privacidade e Segurança."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizzazione negata. Concedi l'accesso in Impostazioni di Sistema → Privacy e sicurezza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ запрещён. Разрешите доступ в Системных настройках → Конфиденциальность и защита."
          }
        }
      }
    },
    "Permission will be requested the first time the trigger fires.": {
