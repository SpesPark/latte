          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quais contextos devem manter seu Mac acordado. Você pode alterar qualquer coisa depois nos Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
