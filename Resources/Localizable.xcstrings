            "value": "Wähle, was deinen Mac wach halten soll"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez ce qui doit garder votre Mac éveillé"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o que deve manter seu Mac acordado"
          }
        },
        "it": {
