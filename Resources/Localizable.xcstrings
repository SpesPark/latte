    "Once any trigger turns Latte on or off, the event is recorded for 14 days.": {
      "comment": "ActivityTab — privacy + retention explanation",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트리거가 Latte를 켜거나 끌 때마다 해당 이벤트는 14일간 기록됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリガがLatteをオンまたはオフにすると、そのイベントは14日間記録されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当任一触发器开启或关闭 Latte 时,该事件将记录 14 天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當任一觸發條件開啟或關閉 Latte 時,該事件會被記錄 14 天。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un disparador activa o desactiva Latte, el evento se registra durante 14 días."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Auslöser Latte ein- oder ausschaltet, wird das Ereignis 14 Tage lang aufgezeichnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'un déclencheur active ou désactive Latte, l'événement est enregistré pendant 14 jours."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um gatilho ativa ou desativa o Latte, o evento é registrado por 14 dias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un trigger attiva o disattiva Latte, l'evento viene registrato per 14 giorni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда триггер включает или выключает Latte, событие сохраняется 14 дней."
          }
        }
      }
    },
    "Only on networks you trust (or never on networks you avoid).": {
      "comment": "Onboarding trigger card description — Wi-Fi trigger",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰하는 네트워크에서만 (또는 피하는 네트워크에서는 절대 안 함)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼するネットワークでのみ（または避けるネットワークでは絶対に動作しない）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在您信任的网络上（或在您要避开的网络上从不）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在您信任的網路上（或在您要避開的網路上從不）。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en redes en las que confías (o nunca en redes que evitas)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur in Netzwerken, denen du vertraust (oder nie in Netzwerken, die du meidest)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement sur les réseaux en lesquels vous avez confiance (ou jamais sur ceux à éviter)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas em redes em que você confia (ou nunca em redes que evita)."
          }
        },
        "it": {
