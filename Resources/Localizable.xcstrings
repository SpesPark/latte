    "Once any trigger turns Latte on or off, the event is recorded for 14 days.": {
      "comment": "ActivityTab — privacy + retention explanation",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트리거가 Latte를 켜거나 끌 때마다 해당 이벤트는 14일간 기록됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリガがLatteをオンまたはオフにすると、そのイベントは14日間記録されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当任一触发器开启或关闭 Latte 时,该事件将记录 14 天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當任一觸發條件開啟或關閉 Latte 時,該事件會被記錄 14 天。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un disparador activa o desactiva Latte, el evento se registra durante 14 días."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Auslöser Latte ein- oder ausschaltet, wird das Ereignis 14 Tage lang aufgezeichnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'un déclencheur active ou désactive Latte, l'événement est enregistré pendant 14 jours."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um gatilho ativa ou desativa o Latte, o evento é registrado por 14 dias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un trigger attiva o disattiva Latte, l'evento viene registrato per 14 giorni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда триггер включает или выключает Latte, событие сохраняется 14 дней."
          }
        }
      }
    },
    "Permission denied. Grant access in System Settings → Privacy & Security.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한이 거부되었습니다. 시스템 설정 → 개인정보 보호 및 보안에서 접근을 허용하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限が拒否されました。システム設定 → プライバシーとセキュリティでアクセスを許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限被拒绝。请在 系统设置 → 隐私与安全性 中授予访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "權限被拒絕。請在 系統設定 → 私隱與安全性 中授予存取權。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiso denegado. Concede acceso en Ajustes del Sistema → Privacidad y seguridad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff verweigert. Zugriff in Systemeinstellungen → Datenschutz & Sicherheit gewähren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation refusée. Accordez l'accès dans Réglages Système → Confidentialité et sécurité."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissão negada. Conceda acesso em Ajustes do Sistema → Privacidade e Segurança."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizzazione negata. Concedi l'accesso in Impostazioni di Sistema → Privacy e sicurezza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ запрещён. Разрешите доступ в Системных настройках → Конфиденциальность и защита."
          }
        }
      }
    },
    "Permission will be requested the first time the trigger fires.": {
