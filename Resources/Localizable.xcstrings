    "No schedules configured. Add one below — e.g. “Mon–Fri, 09:00–18:00” for working hours.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No schedules configured. Add one below — e.g. “Mon–Fri, 09:00–18:00” for working hours."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정된 일정이 없습니다. 아래에서 하나 추가하세요 — 예: 업무 시간의 경우 “월–금, 09:00–18:00”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールが設定されていません。下に追加してください — 例: 勤務時間の場合は“月–金、09:00–18:00”。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未配置任何计划。在下方添加一个 — 例如,工作时间为“周一–周五, 09:00–18:00”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定任何排程。在下方新增一個 — 例如,工作時段為“週一–週五, 09:00–18:00”。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay horarios configurados. Añade uno abajo — p. ej. “Lun–Vie, 09:00–18:00” para horario laboral."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Zeitpläne konfiguriert. Füge unten einen hinzu — z. B. „Mo–Fr, 09:00–18:00“ für Arbeitszeiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun horaire configuré. Ajoutez-en un ci-dessous — par ex. « Lun–Ven, 09:00–18:00 » pour les heures de travail."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
