    "Crosses midnight — runs from start time on the selected day(s) until the end time the next morning.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crosses midnight — runs from start time on the selected day(s) until the end time the next morning."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자정을 지남 — 선택한 요일의 시작 시간부터 다음 날 아침 종료 시간까지 실행됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "深夜をまたぐ — 選択した日の開始時刻から翌朝の終了時刻まで実行されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跨越午夜 — 从所选日期的开始时间运行到第二天早晨的结束时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跨越午夜 — 從所選日期的開始時間執行到隔天早上的結束時間。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cruza la medianoche: se ejecuta desde la hora de inicio del día seleccionado hasta la hora de fin de la mañana siguiente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überquert Mitternacht — läuft von der Startzeit am ausgewählten Tag bis zur Endzeit am nächsten Morgen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traverse minuit — s'exécute de l'heure de début du ou des jours sélectionnés jusqu'à l'heure de fin du lendemain matin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cruza a meia-noite — executa do horário de início no(s) dia(s) selecionado(s) até o horário de fim da manhã seguinte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attraversa la mezzanotte — viene eseguito dall'ora di inizio nel/i giorno/i selezionato/i fino all'ora di fine del mattino successivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пересекает полночь — выполняется от времени начала в выбранный день(дни) до времени окончания на следующее утро."
          }
        }
      }
    },
