<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  STAGED, INACTIVE entitlements for iCloud sync (docs/design/10 §9, §11 Phase 1).

  This file is NOT referenced by any build setting. The default build signs
  with Configuration/Latte.entitlements (no CloudKit) so it stays buildable
  with personal/automatic signing pre-S8.5. Activation is a Phase 2 step:
  when LATTE_ICLOUD_SYNC is enabled AND the Apple Developer Program (S8.5) has
  provisioned the iCloud.com.parkbyeongjun.latte container on the App ID, point
  CODE_SIGN_ENTITLEMENTS at this file in project.yml.

  Delta over Latte.entitlements:
   - com.apple.developer.icloud-services      = [CloudKit]   (private-DB sync)
   - com.apple.developer.icloud-container-identifiers        (the container id)
   - com.apple.security.network.client        (CloudKit traffic; S39 dropped
     this unused key — CloudKit re-introduces the need)
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <key>com.apple.security.personal-information.location</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.parkbyeongjun.latte</string>
    </array>
</dict>
</plist>
